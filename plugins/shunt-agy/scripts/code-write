#!/bin/bash
# CLI shape and prompt structure adapted from Spotify's shunt plugin
# (Apache-2.0): https://github.com/spotify/portal-ai-plugins/blob/main/plugins/shunt/scripts/code-write
# Delegation itself was rewritten against agy's stream-json headless mode
# instead of the Portal CLI's aika:invoke-chat action — see scripts/lib/worker.sh
# and /NOTICE.
#
# Delegate boilerplate generation to the agy worker model.
# Usage: code-write --spec "write tests for UserService" --reference ref.test.ts --target out.test.ts [--force]

. "$(cd "$(dirname "$0")" && pwd)/lib/worker.sh"

spec=""
reference=""
target=""
force=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec)       shunt_need_value --spec $#; spec="$2"; shift 2 ;;
    --reference)  shunt_need_value --reference $#; reference="$2"; shift 2 ;;
    --target)     shunt_need_value --target $#; target="$2"; shift 2 ;;
    --force)     force=1; shift ;;
    *)           shift ;;
  esac
done

if [ -z "$spec" ]; then
  echo "Error: --spec is required" >&2
  exit 1
fi

# A bare spec would generate context-free code that matches nothing in the
# project — fail loudly rather than write plausible-looking output.
if [ -z "$reference" ]; then
  echo "Error: --reference is required — pass a file whose patterns the output should match." >&2
  echo "For a follow-up, reference the file the previous call just generated." >&2
  exit 1
fi
if [ ! -f "$reference" ]; then
  echo "Error: reference file not found: $reference" >&2
  exit 1
fi

# Checked before any model call: a wrong --target must not cost a generation or a file.
if [ -n "$target" ]; then
  if [ "$target" -ef "$reference" ]; then
    echo "Error: --target is the same file as --reference" >&2
    exit 1
  fi
  if [ -d "$target" ] || [ ! -d "$(dirname "$target")" ]; then
    echo "Error: --target must be a file inside an existing directory: $target" >&2
    exit 1
  fi
  if [ -e "$target" ] && [ -z "$force" ]; then
    echo "Error: $target already exists — pass --force to overwrite it" >&2
    exit 1
  fi
fi

shunt_preflight || exit 1
shunt_tmpfile message_file || exit 1
shunt_tmpfile answer_file || exit 1

{
  echo "You generate code files based on a spec and reference files. Match the existing patterns, conventions, naming, and style exactly. Output only the code — no explanations, no markdown fences unless asked. If the spec is ambiguous, make reasonable choices that match the patterns in the reference code."
  echo
  printf 'Spec: %s\n\nReference:\n' "$spec"
  cat "$reference"
} > "$message_file"

shunt_invoke "$message_file" > "$answer_file" || exit 1

# Strip a markdown fence the model wrapped around the whole answer despite
# instructions: an opening fence on the first line paired with a closing fence
# on the last. Fences inside the content (a README, a docstring) stay.
body=$(cat "$answer_file")
first=${body%%$'\n'*}
last=${body##*$'\n'}
if [[ $body == *$'\n'* && $first == '```'* && $last =~ ^'```'[[:space:]]*$ ]]; then
  rest=${body#*$'\n'}
  if [[ $rest == *$'\n'* ]]; then body=${rest%$'\n'*}; else body=; fi
fi

if [ -n "$target" ]; then
  printf '%s\n' "$body" > "$target"
  echo "Wrote $(wc -l < "$target" | tr -d ' ') lines to $target" >&2
else
  printf '%s\n' "$body"
fi

echo "[shunt-agy: delegated to $AGY_MODEL]" >&2
