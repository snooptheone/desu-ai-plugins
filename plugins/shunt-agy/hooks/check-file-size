#!/bin/bash
# Adapted from Spotify's shunt plugin (Apache-2.0):
# https://github.com/spotify/portal-ai-plugins/blob/main/plugins/shunt/hooks/check-file-size
# Changes: the block message points at this repo's bulk-reader skill/agy worker
# instead of Spotify's Portal-CLI-backed one; output uses Claude Code's
# hookSpecificOutput format; a byte limit and a binary-file pass-through were
# added. See /NOTICE for details.
#
# Block full-file reads on large files, redirect to the bulk-reader skill.
# Self-contained: all routing logic lives here, no CLAUDE.md needed.

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac
# Newlines alone miss a minified bundle on one line, so size counts too.
MAX_BYTES="${SHUNT_MAX_BYTES:-100000}"
case "$MAX_BYTES" in ''|*[!0-9]*) MAX_BYTES=100000 ;; esac

input=$(cat)

file_path=$(echo "$input" | jq -r '.tool_input.file_path // empty')
offset=$(echo "$input" | jq -r '.tool_input.offset // empty')
limit=$(echo "$input" | jq -r '.tool_input.limit // empty')

# Allow targeted reads (offset or limit set) — Claude already knows what it needs
if [ -n "$offset" ] || [ -n "$limit" ]; then
  exit 0
fi

# Allow if file doesn't exist or path is empty
if [ -z "$file_path" ] || [ ! -f "$file_path" ]; then
  exit 0
fi

# Allow binary files (images, PDFs): their "lines" are random newline bytes,
# and agy can't view them, so redirecting would only block a legitimate read.
grep -Iq '' "$file_path" || exit 0

# Allow small files — delegation overhead isn't worth it
lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
bytes=$(wc -c < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
if [ "$lines" -le "$MIN_LINES" ] && [ "$bytes" -le "$MAX_BYTES" ]; then
  exit 0
fi

jq -n --arg r "File is ${lines} lines, ${bytes} bytes (limits: ${MIN_LINES} lines, ${MAX_BYTES} bytes). Use the bulk-reader skill to delegate this read to agy instead of reading it directly. If you need exact content for editing, re-read with an offset/limit for just the section you need." '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
