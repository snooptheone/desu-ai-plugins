diff --git a/inform/wg_wireguard.go b/inform/wg_wireguard.go
new file mode 100644
index 0000000..32b57e9
--- /dev/null
+++ b/inform/wg_wireguard.go
@@ -0,0 +1,54 @@
+package inform
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"fmt"
+	"os"
+)
+
+// A gateway adopted by a controller that supports WireGuard is asked for a key pair with
+// {"_type":"cmd","cmd":"wg-genkeypair","request_id":...}. Until the answer arrives on the device's next inform
+// (inform_as_notif=true, notif_reason="cmd", notif_payload={event_string, request_id, params:{private_key,public_key}})
+// the controller keeps asking, never finishes provisioning the gateway, and does not offer the zone-based firewall.
+// Keys are random per request and live in memory only.
+
+func (s *Session) wgHandle(requestID string) []Effect {
+	if requestID == "" || (s.wgNotif != nil && s.wgRequestID == requestID) {
+		return nil
+	}
+	priv := make([]byte, 32)
+	if _, err := rand.Read(priv); err != nil {
+		return nil
+	}
+	priv[0] &= 248
+	priv[31] &= 127
+	priv[31] |= 64
+	key, err := ecdh.X25519().NewPrivateKey(priv)
+	if err != nil {
+		return nil
+	}
+	s.wgRequestID = requestID
+	s.wgSent = false
+	s.wgNotif = map[string]any{
+		"event_string": "wg-genkeypair",
+		"request_id":   requestID,
+		"params": map[string]any{
+			"private_key": base64.StdEncoding.EncodeToString(key.Bytes()),
+			"public_key":  base64.StdEncoding.EncodeToString(key.PublicKey().Bytes()),
+		},
+	}
+	fmt.Fprintln(os.Stderr, "wg-genkeypair: answering on the next inform")
+	return nil
+}
+
+func (s *Session) wgAttach(m map[string]any) {
+	if s.wgNotif == nil {
+		return
+	}
+	m["inform_as_notif"] = true
+	m["notif_reason"] = "cmd"
+	m["notif_payload"] = s.wgNotif
+	s.wgSent = true
+}
diff --git a/inform/wg_wireguard_test.go b/inform/wg_wireguard_test.go
new file mode 100644
index 0000000..0229f2f
--- /dev/null
+++ b/inform/wg_wireguard_test.go
@@ -0,0 +1,46 @@
+package inform
+
+import (
+	"encoding/base64"
+	"testing"
+	"time"
+)
+
+func TestWgGenkeypairIsAnsweredOnceThenCleared(t *testing.T) {
+	s := &Session{}
+	s.wgHandle("req-1")
+	m := map[string]any{}
+	s.wgAttach(m)
+	if m["inform_as_notif"] != true || m["notif_reason"] != "cmd" {
+		t.Fatalf("reply not attached: %v", m)
+	}
+	n := m["notif_payload"].(map[string]any)
+	if n["event_string"] != "wg-genkeypair" || n["request_id"] != "req-1" {
+		t.Fatalf("bad payload: %v", n)
+	}
+	for _, k := range []string{"private_key", "public_key"} {
+		raw, err := base64.StdEncoding.DecodeString(n["params"].(map[string]any)[k].(string))
+		if err != nil || len(raw) != 32 {
+			t.Fatalf("%s is not 32 base64 bytes", k)
+		}
+	}
+	s.Apply(time.Now(), []byte(`{"_type":"noop","interval":10}`))
+	m2 := map[string]any{}
+	s.wgAttach(m2)
+	if len(m2) != 0 {
+		t.Fatalf("answer sent again after the controller replied: %v", m2)
+	}
+}
+
+func TestSetAuthKey(t *testing.T) {
+	const k = "0123456789abcdef0123456789abcdef"
+	s := NewSession(Descriptor{MAC: "00:27:22:e0:00:01"}, "http://x/inform", time.Now())
+	s.SetAuthKey("not-hex")
+	if s.AuthKey() != DefaultKey {
+		t.Fatalf("a bad key must be ignored, got %q", s.AuthKey())
+	}
+	s.SetAuthKey(k)
+	if s.AuthKey() != k {
+		t.Fatalf("key %q, want %q", s.AuthKey(), k)
+	}
+}
